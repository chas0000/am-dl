[Unit]
Description=am-dl (Apple Music 服务端下载 · 轻量版)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@PROJECT@

@ROOTS_LINE@
@ROOT_LINE@
Environment=AM_DL_CONCURRENCY=@CONCURRENCY@
Environment=AM_DL_WRAPPER=@WRAPPER@
Environment=AM_DL_LISTEN=@LISTEN@:@PORT@
Environment=AM_DL_UPSTREAM=@UPSTREAM@
@TOKEN_LINE@

ExecStart=@PROJECT@/dist/am-dl

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=am-dl

ProtectSystem=strict
ReadWritePaths=@RW_PATHS@
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
